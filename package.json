{
  "name": "past-life-archive",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @pastlife/api --filter @pastlife/mobile --filter @pastlife/admin --filter @pastlife/worker dev",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "content:check": "corepack pnpm --filter @pastlife/content test && corepack pnpm --filter @pastlife/scoring test && corepack pnpm --filter @pastlife/content typecheck && node scripts/check-story-art.mjs && node scripts/check-story-diversity.mjs && node scripts/check-release-image-registry.mjs",
    "final-moment:check": "node scripts/tsx-cli.mjs scripts/check-final-moment-art.ts",
    "translation:source": "node scripts/tsx-cli.mjs scripts/export-story-translation-source.ts",
    "translation:source:check": "node scripts/tsx-cli.mjs scripts/verify-story-translation-source.ts",
    "translation:english:draft": "node scripts/translate-english-batch.mjs",
    "translation:thai:draft": "node scripts/translate-english-batch.mjs --locale th --include-clown",
    "translation:thai:check": "node scripts/check-english-drafts.mjs --locale th",
    "translation:thai:package": "node scripts/package-english-catalog.mjs --locale th",
    "translation:japanese:draft": "node scripts/translate-english-batch.mjs --locale ja --include-clown",
    "translation:japanese:ui": "node scripts/translate-japanese-ui.mjs",
    "translation:japanese:check": "node scripts/check-english-drafts.mjs --locale ja",
    "translation:japanese:package": "node scripts/package-english-catalog.mjs --locale ja",
    "translation:english:check": "node scripts/check-english-drafts.mjs",
    "translation:english:package": "node scripts/package-english-catalog.mjs",
    "test:e2e": "corepack pnpm --filter @pastlife/api test:e2e",
    "test:e2e:browser": "node scripts/run-browser-e2e.mjs",
    "test:staging-config": "node --test scripts/staging-env.test.mjs",
    "env:neon": "node scripts/configure-neon-env.mjs",
    "staging:preflight": "node --env-file=.env scripts/check-staging-env.mjs",
    "staging:storage-smoke": "corepack pnpm --filter @pastlife/api storage:smoke",
    "db:migrate": "corepack pnpm exec prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:status": "corepack pnpm exec prisma migrate status --schema prisma/schema.prisma",
    "db:migrate:deploy": "corepack pnpm exec prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "corepack pnpm exec prisma db seed --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@pastlife/content": "workspace:*",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
