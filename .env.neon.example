# Neon pooled URL for the running API (copy from Neon Connect > pooled)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
# For Prisma migrations, use the direct (non-pooler) URL in DATABASE_URL temporarily.
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
USE_IN_MEMORY_DB=false
USE_MOCK_GOOGLE=true
CONTENT_VERSION=2.0.0
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
