# Neon pooled URL for the running API (copy from Neon Connect > pooled)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
# Neon direct URL for Prisma migrations, seed, introspection, and admin tooling
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
USE_IN_MEMORY_DB=false
USE_MOCK_GOOGLE=false
GOOGLE_CLIENT_IDS=WEB_CLIENT_ID,IOS_CLIENT_ID,ANDROID_CLIENT_ID
AI_IMAGE_API_URL=
AI_IMAGE_API_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pastlife-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
CONTENT_VERSION=2.0.0
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_USE_MOCK_GOOGLE=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=IOS_CLIENT_ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=ANDROID_CLIENT_ID
